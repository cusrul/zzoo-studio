---
import "../styles/studio.css";
const {
  title = "ZZOO 动动物园",
  description = "ZZOO 动动物园的硬件、软件与开源项目。体验作品，查阅文档，动手开发。",
} = Astro.props;
const publicLinks = [
  { label: "淘宝店铺", href: "https://7l2ggxehxy16y5ayzrou5ygndnxaatk.taobao.com/" },
  { label: "闲鱼主页", href: "https://www.goofish.com/personal?userId=4183904906" },
  { label: "GitHub", href: "https://github.com/cusrul" },
  { label: "B站", href: "https://space.bilibili.com/378996894" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fafaf8" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label="ZZOO 动动物园首页">
        <img
          class="brand-art"
          src="/brand/zzoo.svg"
          alt="ZZOO 动动物园"
          width="393"
          height="520"
        />
      </a>
      <nav aria-label="主导航">
        <a href="/projects/">项目</a>
        <a href="/docs/">文档</a>
        <a href="/#stores">店铺</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer wrap" id="stores">
      <nav class="store-list" aria-label="公共链接与交流">
        {publicLinks.map(({ label, href }) => (
          <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>
        ))}
        <span>QQ 交流群：2156052701</span>
      </nav>
    </footer>
  </body>
</html>
