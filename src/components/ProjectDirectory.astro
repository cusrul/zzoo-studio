---
import projects from "../data/generated-projects.json";
import WatchInteractive from "./WatchInteractive.astro";
const { carousel = false } = Astro.props;
const canRotate = carousel && projects.length > 1;
---

<section class:list={["project-directory", { "project-carousel": canRotate }]} aria-label="项目目录" data-project-carousel={canRotate ? "" : undefined}>
 <div class="project-window">
  <div class="project-track">
  {projects.map((project) => (
    <article class="project-entry">
      <div>
        <h2>
          <a href={`/projects/${project.id}/`}>{project.title}</a>
        </h2>
        <p class="muted">{project.tagline}</p>
        <div class="hero-actions">
          <a class="text-link" href={`/projects/${project.id}/`}>
            了解项目 ↗
          </a>
          <a class="text-link" href={`/docs/${project.id}/`}>
            使用文档 ↗
          </a>
        </div>
      </div>
      {project.id === "crabit" && (
        <div class="model-panel">
          <WatchInteractive />
          <p class="model-caption">
            拖动旋转，点侧键操作。NanoUI 本地模拟，不连接设备。
          </p>
        </div>
      )}
    </article>
  ))}
  </div>
 </div>
 {canRotate && (
   <div class="project-switcher" hidden>
     <button type="button" data-previous aria-label="上一个项目">←</button>
     <span data-position>1 / {projects.length}</span>
     <button type="button" data-next aria-label="下一个项目">→</button>
     <button type="button" data-pause aria-pressed="false">暂停轮播</button>
   </div>
 )}
</section>

<script>
  import { mountProjectCarousels } from "../scripts/project-carousel.js";
  mountProjectCarousels();
</script>
