---
import Studio from "../../../layouts/Studio.astro";
import projects from "../../../data/generated-projects.json";
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}
const { project } = Astro.props;
---

<Studio
  title={`${project.title} 文档 — ZZOO 动动物园`}
  description={project.tagline}
>
  <section class="wrap page-intro">
    <p>
      <a href="/docs/">全部项目文档</a> / {project.title}
    </p>
    <h1>{project.title} 文档</h1>
    <div class="doc-list">
      {project.docs.map((doc) => (
        <article>
          <h2>
            <a href={doc.href}>{doc.title} ↗</a>
          </h2>
          <p>{doc.description}</p>
        </article>
      ))}
    </div>
    <a class="text-link" href={`/projects/${project.id}/`}>
      项目介绍 ↗
    </a>
  </section>
</Studio>
